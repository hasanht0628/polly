# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment (use .env.example)
.env

# OS
.DS_Store

# Runtime / local data
data/

# Local test fixtures (may contain PII; not committed)
fixtures/**
!fixtures/README.md
!fixtures/**/.gitkeep

# Eval goldens (regenerated via evals/bootstrap_goldens.py)
evals/court/ocr/goldens/*
!evals/court/ocr/goldens/.gitkeep
evals/court/extract/goldens/*
!evals/court/extract/goldens/.gitkeep
evals/classification/goldens/*
!evals/classification/goldens/.gitkeep
evals/classification/last_eval_run.txt

# Legacy golden locations (pre court/ layout) — do not reintroduce
evals/ocr/
evals/extract/

# Eval regression snapshots (local only)
evals/runs/*
!evals/runs/.gitignore
!evals/runs/.gitkeep
